{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "noEmit": true
  }
}
